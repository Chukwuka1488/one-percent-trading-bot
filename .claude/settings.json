      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(env)",
      "Bash(printenv:*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
