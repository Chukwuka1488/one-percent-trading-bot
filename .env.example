# One Percent Trading Bot - Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_local_dev
POSTGRES_DB=trading_bot

# =============================================================================
# n8n Settings
# =============================================================================
N8N_HOST=localhost
TIMEZONE=America/New_York

# n8n Basic Auth (optional, enable for production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# n8n PostgreSQL Credential Settings (for UI setup)
# Host: postgres | Port: 5432 | SSL: Disabled

# =============================================================================
# API Keys (used by n8n workflows)
# =============================================================================
# Copy from your .envrc or get new keys
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Freqtrade - Trading Bot
# =============================================================================
# Run: ./scripts/generate-freqtrade-config.sh after setting these

# Exchange Configuration (Kraken - US Legal)
# Kraken uses USD as base currency, not USDT
# Get API keys at: https://www.kraken.com/u/security/api
EXCHANGE_NAME=kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Freqtrade API Server (auto-generated if empty)
# Generate secure values: openssl rand -hex 32
FREQTRADE_JWT_SECRET=
FREQTRADE_WS_TOKEN=
FREQTRADE_API_USER=freqtrade
FREQTRADE_API_PASSWORD=

# Telegram Notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Future Services
# =============================================================================
# REDIS_URL=redis://localhost:6379
