      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git push origin*)",
      "Bash(gh *)",

      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm exec*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(npm audit*)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",

      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(tsc*)",
      "Bash(eslint*)",
      "Bash(prettier*)",
      "Bash(vitest*)",
      "Bash(jest*)",

      "Bash(python*)",
      "Bash(python3*)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest*)",
      "Bash(uv *)",
      "Bash(poetry *)",

      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker images*)",
      "Bash(docker inspect*)",
      "Bash(docker exec*)",
      "Bash(docker compose*)",
      "Bash(docker-compose*)",
      "Bash(docker build*)",
      "Bash(docker run*)",
      "Bash(docker start*)",
      "Bash(docker stop*)",
      "Bash(docker restart*)",

      "Bash(make *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(rustc*)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ag *)",
      "Bash(fd *)",
      "Bash(fzf *)",

      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(ln *)",

      "Bash(./ai/tools/*)",
      "Bash(freqtrade *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(> /dev/*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(docker system prune*)",
      "Bash(DROP *)",
      "Bash(DELETE FROM*)",
      "Bash(TRUNCATE *)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(shutdown*)",
      "Bash(reboot*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep '\\.md$' | xargs -r npx prettier --write"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false
}
